# Copy to .env and fill in your own keys. Never commit the real .env file.

# OpenWeatherMap API key, used for race-day rain/temperature forecasts.
# Get one free at https://openweathermap.org/api
# If unset, the pipeline falls back to a neutral forecast (0% rain, 20C).
OPENWEATHER_API_KEY=

# Anthropic API key, used only by the optional LLM race-summary feature
# (src/f1_predictor/llm_summary.py). If unset, that feature is skipped.
ANTHROPIC_API_KEY=

# Where FastF1 caches downloaded session data. Defaults to ./f1_cache.
F1_CACHE_DIR=f1_cache

# MLflow tracking URI. Defaults to a local ./mlruns directory if unset.
MLFLOW_TRACKING_URI=
